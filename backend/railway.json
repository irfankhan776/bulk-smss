{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "backend.dockerfile"
  },
  "deploy": {
    "numReplicas": 1,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  },
  "envs": {
    "TELNYX_API_KEY": { "required": true },
    "TELNYX_PUBLIC_KEY": { "required": true },
    "TELNYX_PHONE_NUMBER": { "required": true },
    "DEFAULT_FROM_NUMBER": { "required": true },
    "DATABASE_URL": { "required": true },
    "REDIS_URL": { "required": true },
    "CLOUDFLARE_ACCOUNT_ID": { "required": true },
    "CLOUDFLARE_API_TOKEN": { "required": true },
    "CLOUDFLARE_PROJECT_NAME": { "required": true },
    "FRONTEND_URL": { "required": false }
  }
}
